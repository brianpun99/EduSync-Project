# Copy this file to .env and fill in real values before running the server.

# Groq API key for the cloud inference layer (chat answers + quiz generation).
GROQ_API_KEY=

# Optional: override the default Llama-3 model served by Groq.
GROQ_MODEL=llama-3.1-8b-instant

# Secret used to sign local session tokens. Change this to a random string.
EDUSYNC_JWT_SECRET=change-me-in-production

# Local port the API listens on (always bound to 127.0.0.1, never 0.0.0.0).
EDUSYNC_PORT=8000
